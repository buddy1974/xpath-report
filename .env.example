# X-PATH — environment (Session 01). Copy to .env.local and fill.
# Generate secrets locally:  openssl rand -base64 32
# NEVER commit real values. NEXT_PUBLIC_* is browser-exposed — no secrets there.

# App
NEXT_PUBLIC_APP_URL=https://xpath.report

# Database — Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth — Auth.js + TOTP
AUTH_SECRET=
AUTH_URL=https://xpath.report
ENCRYPTION_KEY=            # base64 of 32 bytes — encrypts TOTP secrets at rest

# Storage — Cloudflare R2 (audio, scans, PDFs) — used from Session 02+
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# AI — OpenAI (Session 02+; pseudonymise input before any call)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Notifications — Telegram (later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Jobs
CRON_SECRET=

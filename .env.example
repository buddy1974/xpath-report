# X-PATH — environment. Copy to .env.local and fill.
# Generate self-issued secrets locally:  openssl rand -base64 32
# NEVER commit real values. NEXT_PUBLIC_* is browser-exposed — no secrets there.
# Set the same keys in Vercel (Project → Settings → Environment Variables),
# scoped Production / Preview / Development as needed.

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://xpath.report

# ── Database — Neon (Postgres) ── needed now ───────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth — Auth.js + TOTP ── self-generated, needed now ────────────────────
AUTH_SECRET=
AUTH_URL=https://xpath.report
# base64 of 32 bytes — encrypts TOTP secrets at rest
ENCRYPTION_KEY=
# protects internal background-job endpoints (Vercel Cron or similar)
CRON_SECRET=

# ── Storage — Cloudflare R2 (audio, scans, PDFs) ── needed now ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ── AI — provider-swappable structuring; transcription is OpenAI-only ──────
# AI_STRUCTURING_PROVIDER selects which LLM drafts/structures report text.
# Transcription (speech→text) always uses OpenAI Whisper — Anthropic has no
# speech-to-text API, so OPENAI_API_KEY is required regardless of this switch.
AI_STRUCTURING_PROVIDER=openai

# OpenAI — Whisper transcription (required) + optional structuring
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Anthropic — optional alternative structuring/reasoning provider
ANTHROPIC_API_KEY=
# check console.anthropic.com for the current model id when you get the key
ANTHROPIC_MODEL=

# ── PDF generation worker ── OPEN DECISION, no vendor chosen yet ───────────
# Off-Vercel by design (Chromium exceeds serverless limits) — provider TBD
# (self-hosted, Render/Railway/Fly.io + Playwright, or Browserless.io-style
# managed service). Leave blank until M6; Claude Code will specify then.
PDF_WORKER_URL=
PDF_WORKER_SECRET=

# ── Cloudflare DNS/WAF (xpath.report) ── needed at M7 (go-live), not now ───
# Only required if automating DNS/WAF via API; the dashboard alone is enough
# to point the domain at Vercel when the time comes.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
